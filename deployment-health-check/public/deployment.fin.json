{
	"startup_app": {
		"name": "HERE Deployment Health Check",
		"icon": "https://assets-here-staging.s3.us-east-2.amazonaws.com/images/here-icon.png",
		"description": "Checks whether this desktop can reach HERE services and launch a HERE based application.",
		"url": "http://localhost:6060/index.html",
		"uuid": "here-deployment-health-check",
		"autoShow": true,
		"defaultWidth": 1280,
		"defaultHeight": 1100,
		"resizable": true,
		"permissions": {
			"System": {
						"downloadAsset": true
					},
			"webAPIs": ["clipboard-sanitized-write"]
		}
	},
	"licenseKey": "openfin-demo-license-key",
	"runtime": {
		"arguments": "--enable-mesh --security-realm=deployment-health-check",
		"version": "stable"
	},
	"shortcut": {
		"company": "HERE",
		"description": "HERE Deployment Health Check",
		"icon": "https://assets-here-staging.s3.us-east-2.amazonaws.com/images/here-favicon.ico",
		"name": "HERE Deployment Health Check"
	},
	"supportInformation": {
		"company": "HERE",
		"product": "Deployment Health Check",
		"email": "deployment@here.io",
		"forwardErrorReports": true
	}
}
